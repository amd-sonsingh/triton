# Arm B: the stock image plus the chain-dot patch. Built FROM stock so the patch
# is the only difference between the arms, and so the rebuild is incremental.
ARG STOCK_IMAGE=triton-blasst-ab:stock
FROM ${STOCK_IMAGE}

# The PR's full diff (source and lit test).
COPY 0001-force-chain-dot-across-scf-if.patch /opt/0001-force-chain-dot-across-scf-if.patch
COPY check_binary.py /opt/check_binary.py

# git apply without fuzz: the patch must apply exactly. The provenance file
# records the patch's sha256 so run_ab.sh can detect a stale image.
RUN cd /opt/triton-src \
    && git apply --verbose /opt/0001-force-chain-dot-across-scf-if.patch \
    && printf '%s\n' "$(git rev-parse HEAD)" \
         "patched: 0001-force-chain-dot-across-scf-if.patch sha256=$(sha256sum /opt/0001-force-chain-dot-across-scf-if.patch | cut -d' ' -f1)" \
         > /opt/triton-src-commit.txt \
    && _t0=$(date +%s) \
    && pip install --no-cache-dir -e . --no-build-isolation \
    && echo "rebuild with patch took $(( $(date +%s) - _t0 ))s (expect ~120s incremental, ~600s full)" \
    && python3 -c "import triton; print('Triton rebuilt with patch:', triton.__version__)" \
    && python3 -c "import torch; assert torch.version.hip is not None, 'lost ROCm torch build'; print('torch (ROCm):', torch.__version__)"

# Check the patch reached the built binary, not just the source: compile the
# PR's lit case with this image's triton-opt (see check_binary.py).
RUN grep -q "headFeedsDotOperand" /opt/triton-src/third_party/amd/lib/TritonAMDGPUToLLVM/Utility.cpp \
    && echo "verified: patch present in source" \
    && TRITON_OPT=$(find /opt/triton-src -name triton-opt -type f -perm -u+x | head -1) \
    && if [ -z "$TRITON_OPT" ]; then echo "FATAL: no triton-opt in the build tree" >&2; exit 1; fi \
    && "$TRITON_OPT" /opt/triton-src/test/TritonGPU/amd/accelerate-amd-matmul-chain-dot.mlir -split-input-file \
         --tritonamdgpu-accelerate-matmul="gfx-arch=gfx942 matrix-instruction-size=16" \
       | python3 /opt/check_binary.py \
    && echo "verified: patch present in the built binary ($TRITON_OPT)"

WORKDIR /workspace
